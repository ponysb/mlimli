{
  "name": "mli-agent",
  "version": "1.0.0",
  "description": "魔力工作台：本地 Agent 运行时、React 工作台、Electron 桌面入口与可扩展插件系统",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "build:web:legacy": "vite build --mode legacy",
    "preelectron": "node node_modules/electron/install.js",
    "electron": "node node_modules/electron/cli.js electron/main.cjs",
    "export:client": "node scripts/export-client.mjs",
    "pack:win": "node scripts/package-win.mjs --modern --dir",
    "dist:win": "node scripts/package-win.mjs",
    "dist:win:modern": "node scripts/package-win.mjs --modern",
    "dist:win:legacy": "node scripts/package-win.mjs --legacy",
    "dist:win:all": "npm run dist:win",
    "verify:win": "node scripts/verify-win.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ponysb/mlimli.git"
  },
  "homepage": "https://github.com/ponysb/mlimli#readme",
  "bugs": {
    "url": "https://github.com/ponysb/mlimli/issues"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "latest",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dotenv": "17.2.2",
    "lucide-react": "latest",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "streamdown": "^2.6.0",
    "vite": "latest",
    "xterm-readline": "^1.2.2"
  },
  "devDependencies": {
    "core-js": "3.50.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-legacy": "npm:electron@22.3.27",
    "esbuild": "0.28.2",
    "undici": "5.29.0"
  },
  "private": true
}
